# SQLite for local/demo. For production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/professionalmarket"
DATABASE_URL="file:./dev.db"

# Admin panel credentials (demo defaults — change in production!)
ADMIN_EMAIL="admin@professionalmarket.dev"
ADMIN_PASSWORD="change-me-please"

# Secret used to sign admin session cookies (>= 32 random chars in production)
AUTH_SECRET="dev-secret-change-me-0123456789abcdef"
